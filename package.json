{
  "name": "ai-app-frontend",
  "version": "6.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "audit:lighthouse": "npm run build && node scripts/lighthouse-audit.mjs",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:v5-real": "bash scripts/run-v5-real-e2e.sh",
    "test:e2e:v5-real:spec": "V5_REAL_E2E=1 PLAYWRIGHT_PORT=5174 PLAYWRIGHT_BASE_URL=http://127.0.0.1:5174 LYLE_BACKEND_PROXY=${V5_REAL_BACKEND_URL:-http://127.0.0.1:8081} playwright test tests/e2e/v5-controlled-agent-loop.real.spec.ts --project=chromium",
    "test:e2e:v6-real": "bash scripts/run-v6-real-e2e.sh",
    "test:e2e:v6-real:spec": "V6_REAL_E2E=1 PLAYWRIGHT_PORT=5175 PLAYWRIGHT_BASE_URL=http://127.0.0.1:5175 LYLE_BACKEND_PROXY=${V6_REAL_BACKEND_URL:-http://127.0.0.1:8082} playwright test tests/e2e/v6-trusted-delegation.real.spec.ts --project=chromium"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^2.3.1",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.2",
    "lighthouse": "^13.4.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
